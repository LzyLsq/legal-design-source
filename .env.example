# ===== 数据库 =====
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=flask_login_system

# ===== 安全 =====
SECRET_KEY=please-change-me-to-a-random-string
FLASK_DEBUG=false

# ===== 模型服务 API Key =====
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
MOONSHOT_API_KEY=
GRAPHRAG_CHAT_API_KEY=
GRAPHRAG_EMBEDDING_API_KEY=

# ===== 中间件 =====
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ===== 跨域（逗号分隔）=====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 服务监听（可选，缺省用各服务内置端口）=====
# SERVICE_HOST=127.0.0.1        # 默认仅监听本机；对外部署时显式改成 0.0.0.0
# SERVICE_PORT=5000             # 覆盖单个服务端口
# LOGIN_PORT=5000

# ===== 管理端（可选）=====
# ADMIN_DEFAULT_USERNAME=admin
# ADMIN_DEFAULT_PASSWORD=请修改为强口令
# MANAGER_URL=http://127.0.0.1:8003

# ===== GraphRAG 问答后端地址 =====
GRAPH_API_BASE=http://127.0.0.1:8012
